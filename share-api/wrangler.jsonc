{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "password-entry-share",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/s/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "password-entry-share",
      "database_id": "7f1aa4c7-e23f-4d1a-9630-0fb7deb4193f",
      "migrations_dir": "migrations"
    }
  ]
}
