{
  "manifest_version": 3,
  "name": "Password Entry",
  "version": "0.3.0",
  "description": "由 macOS 桌面端驱动的本地账号、密码和 TOTP 管理器。",
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "src/background.js", "type": "module"},
  "icons": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"},
  "action": {"default_title": "Password Entry", "default_popup": "src/popup.html", "default_icon": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png"}},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": true}],
  "options_page": "src/options.html"
}
